function fish_prompt
	set -l last_status $status
	set -l cmd_duration (math --scale 0 --scale-mode round "$CMD_DURATION / 1000") # seconds

        # pwd
        fish_is_root_user \
		&& set_color $fish_color_cwd_root \
		|| set_color $fish_color_cwd
        echo -n "$(prompt_pwd)"
        set_color normal
	
	set -g __fish_git_prompt_show_informative_status false
	set -g __fish_git_prompt_showuntrackedfiles true
	set -g __fish_git_prompt_showdirtystate true
	set -g __fish_git_prompt_showupstream auto
	set -g __fish_git_prompt_describe_style default
	set -g __fish_git_prompt_char_upstream_equal ''
	set -g __fish_git_prompt_showcolorhints true
	set -g __fish_git_prompt_color magenta
	set -g __fish_git_prompt_color_branch magenta
	set -g __fish_git_prompt_color_upstream white
	set -g __fish_git_prompt_color_stashstate yellow
	set -g __fish_git_prompt_color_untrackedfiles blue

	# vcs
	set -l vcs_prompt (fish_vcs_prompt '[%s]')
	test -n "$vcs_prompt" && echo -n "$vcs_prompt"

	# job count
	set -l job_count (jobs --group | count)
	if test $job_count -ne 0
		set_color blue
		echo -n "[$job_count]"
		set_color normal
	end

	# cmd duration
	if test $cmd_duration -ge 5
		set_color yellow
		if test $cmd_duration -lt 60
			printf "[%ss]" $cmd_duration
		else if test $cmd_duration -lt 3600
			echo -n (date --utc --date @$cmd_duration "+[%-Mm%-Ss]")
		else
			echo -n (date --utc --date @$cmd_duration "+[%-Hh%-Mm%-Ss]")
		end
		set_color normal
	end

	# status
	if test $last_status -ne 0
		set_color $fish_color_status
		echo -n "[$last_status]"
		set_color normal
	end

	set -l suffix
	switch $fish_bind_mode
		case default
			set suffix "$(set_color --bold red)<"
		case insert
			set suffix '>'
		case replace
			set suffix "$(set_color --bold yellow)^"
		case replace_one
			set suffix "$(set_color --bold green)^"
		case visual
			set suffix "$(set_color --bold magenta)v"
		case '*'
			set suffix '?'
	end
	echo -n "$suffix "
	set_color normal
end

function fish_mode_prompt; end
